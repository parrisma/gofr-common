# GOFR Common Configuration
# This file contains shared secrets and defaults for all GOFR services.
# Load this with EnvLoader or source it in shell scripts.

# JWT Secret - sourced from Vault; do not store here
# GOFR_JWT_SECRET=

# Vault Configuration (non-secret defaults only)
GOFR_AUTH_BACKEND=vault
# GOFR_VAULT_DEV_TOKEN=
# GOFR_VAULT_TOKEN=
GOFR_VAULT_DEV_TOKEN=dev-root-token
GOFR_VAULT_URL=http://gofr-vault:8201
GOFR_VAULT_PATH_PREFIX=gofr/auth
GOFR_VAULT_MOUNT_POINT=secret

# Environment (DEV, TEST, PROD)
GOFR_ENV=DEV

# Logging
GOFR_LOG_LEVEL=INFO
GOFR_LOG_FORMAT=console

# ==============================================================================
# OpenRouter API Key Configuration
# ==============================================================================
# Key lives in TWO places only:
#   1. Vault  (prod / simulation) -- gofr/config/api-keys/openrouter
#   2. secrets/llm_api_key         (test fallback, gitignored)
# Do NOT put the key in any .env file.
#
# To rotate: update Vault + secrets/llm_api_key. Nothing else.
GOFR_IQ_LLM_MODEL=meta-llama/llama-3.1-70b-instruct
