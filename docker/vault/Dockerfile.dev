FROM hashicorp/vault:1.15.4

ARG BUILD_DATE
ARG GIT_COMMIT
LABEL org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.version="1.15.4" \
    org.opencontainers.image.title="gofr-vault" \
      org.opencontainers.image.description="Ephemeral unlocked Vault image for GOFR sec dev verification"

COPY --chmod=755 docker/vault/dev-entrypoint.sh /entrypoint-dev.sh

ENV VAULT_ADDR=http://127.0.0.1:8200 \
    VAULT_API_ADDR=http://gofr-sec-vault:8200 \
    VAULT_DEV_LISTEN_ADDRESS=0.0.0.0:8200 \
    SKIP_SETCAP=true

HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=12 \
    CMD vault status >/dev/null 2>&1 || exit 1

EXPOSE 8200

ENTRYPOINT ["/entrypoint-dev.sh"]
CMD []